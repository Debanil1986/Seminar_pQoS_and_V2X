def unique_id(df):
    current_ts = datetime.now()
    unique_ids = df['ts_gps_destination'].apply(lambda x: 
                                               x.timestamp() + x.microsecond/1000000 
                                               if pd.notna(x) else (current_ts.timestamp() + current_ts.microsecond/1000000))
    df['id'] = unique_ids
    return df


